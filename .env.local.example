NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL="Flexhulp <noreply@flexhulp.be>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Waar admin-meldingen (nieuwe boeking / annulering) naartoe gaan.
# Laat leeg om de ingebouwde standaardwaarde te gebruiken.
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_PHONE=

# Spambescherming (Cloudflare Turnstile, gratis) — optioneel, werkt zonder
# deze sleutels, maar dan ook zonder spambescherming.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Foutmonitoring (Sentry, gratis tier) — optioneel.
NEXT_PUBLIC_SENTRY_DSN=

# Sms-meldingen (Twilio) — optioneel, kost geld per bericht.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Enkel nodig voor account-verwijdering (GDPR). GEHEIM: nooit delen, nooit
# als NEXT_PUBLIC_-variabele zetten. Te vinden in Supabase → Project
# Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=
